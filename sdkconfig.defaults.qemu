# HiLily ESP32 QEMU Configuration
# Use: cp sdkconfig.defaults.qemu sdkconfig.defaults && idf.py fullclean && idf.py build

# ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

# Flash (16MB like real hardware)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM disabled for QEMU (OPI PSRAM emulation hangs on S3)
CONFIG_SPIRAM=n

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# C++ features
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# Logging (verbose for QEMU debugging)
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_ISR_STACKSIZE=2048

# Main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# LVGL
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n

# Disable ESP-SR (not available in QEMU)
CONFIG_MODEL_IN_SPIFFS=n
CONFIG_USE_WAKENET=n

# OTA
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# === QEMU MODE ===
CONFIG_HILILY_QEMU_MODE=y
CONFIG_HILILY_QEMU_MOCK_WIFI_CONNECTED=y
CONFIG_HILILY_QEMU_MOCK_BATTERY_PERCENT=85
